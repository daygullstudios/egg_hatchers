{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nestarium-multiplayer-playtest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "playtest.playnestarium.com/ws*",
      "zone_name": "playnestarium.com"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "egg-hatchers-dev",
    "CAPABILITY_MODE": "protected_playtest",
    "MATCHMAKING_POOL": "protected-v1",
    "MATCHMAKING_SHARD_COUNT": "1",
    "MATCHMAKING_ROUTING_MODE": "single_compatibility"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKING",
        "class_name": "MatchmakingPool"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "SAFETY_AUTHORITY",
      "database_name": "nestarium-safety-authority",
      "database_id": "d11be133-8f76-4f86-b676-14a1d7bb42a9",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 6 * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchmakingPool"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
